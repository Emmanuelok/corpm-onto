@prefix cpm: <https://w3id.org/corruptpm/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Copy this template into an ontology module or extension file and replace placeholders.

cpm:NewControlTemplate a owl:Class ;
    rdfs:subClassOf
        cpm:AntiCorruptionControl,
        cpm:PreventiveControl,
        [ a owl:Restriction ; owl:onProperty cpm:hasControlObjective ; owl:someValuesFrom cpm:PreventionObjective ] ;
    rdfs:label "New control template"@en ;
    skos:definition "Replace with a concise definition of the control."@en ;
    skos:scopeNote "Describe when this control should be used, what it targets, and any implementation caveats."@en .

