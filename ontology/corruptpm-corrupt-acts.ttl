@prefix cpm: <https://w3id.org/corruptpm/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

cpm:corruptpm-corrupt-acts a owl:Ontology ;
    rdfs:label "corruptpm corrupt acts module"@en ;
    owl:imports <corruptpm-core.ttl>, <corruptpm-lifecycle.ttl>, <corruptpm-contractual-cycle.ttl>, <corruptpm-controls.ttl>, <corruptpm-indicators.ttl>, <corruptpm-impacts.ttl>, <corruptpm-causes-vulnerabilities.ttl> .

cpm:Bribery a owl:Class ;
    rdfs:subClassOf cpm:CorruptAct ;
    rdfs:label "Bribery"@en ;
    skos:definition "Offering, giving, receiving, or soliciting an undue advantage to influence a project-related decision or action."@en .

cpm:Kickback a owl:Class ;
    rdfs:subClassOf cpm:Bribery ;
    rdfs:label "Kickback"@en ;
    skos:definition "A bribery arrangement in which a payment or benefit is returned from a contractor, supplier, or recipient to an influencing actor."@en .

cpm:Collusion a owl:Class ;
    rdfs:subClassOf cpm:CorruptAct ;
    rdfs:label "Collusion"@en ;
    skos:definition "Coordination among actors to distort competition, oversight, pricing, allocation, or certification."@en .

cpm:BidRigging a owl:Class ;
    rdfs:subClassOf
        cpm:Collusion,
        [ a owl:Restriction ; owl:onProperty cpm:occursInPhase ; owl:someValuesFrom cpm:ProcurementPhase ],
        [ a owl:Restriction ; owl:onProperty cpm:occursInContractStage ; owl:someValuesFrom cpm:BidEvaluationStage ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:IdenticalBidDocuments ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:BidPricesTooClose ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:RepeatedContractAwardsToSameFirm ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:SingleBidder ],
        [ a owl:Restriction ; owl:onProperty cpm:isMitigatedBy ; owl:someValuesFrom cpm:EProcurement ],
        [ a owl:Restriction ; owl:onProperty cpm:isMitigatedBy ; owl:someValuesFrom cpm:RedFlagAnalytics ],
        [ a owl:Restriction ; owl:onProperty cpm:isMitigatedBy ; owl:someValuesFrom cpm:BidEvaluationCommitteeRotation ],
        [ a owl:Restriction ; owl:onProperty cpm:hasImpact ; owl:someValuesFrom cpm:ReducedCompetition ],
        [ a owl:Restriction ; owl:onProperty cpm:hasImpact ; owl:someValuesFrom cpm:CostOverrun ],
        [ a owl:Restriction ; owl:onProperty cpm:hasImpact ; owl:someValuesFrom cpm:LossOfValueForMoney ],
        [ a owl:Restriction ; owl:onProperty cpm:exploitsDecisionPoint ; owl:someValuesFrom cpm:BidEvaluationDecisionPoint ] ;
    rdfs:label "Bid rigging"@en ;
    skos:definition "A collusive procurement scheme that manipulates bidding or evaluation to predetermine the winner."@en .

cpm:Fraud a owl:Class ;
    rdfs:subClassOf cpm:CorruptAct ;
    rdfs:label "Fraud"@en ;
    skos:definition "Intentional deception or misrepresentation for improper project benefit."@en .

cpm:Embezzlement a owl:Class ;
    rdfs:subClassOf cpm:CorruptAct ;
    rdfs:label "Embezzlement"@en ;
    skos:definition "Misappropriation of funds or assets entrusted to an actor in a project setting."@en .

cpm:Extortion a owl:Class ;
    rdfs:subClassOf cpm:CorruptAct ;
    rdfs:label "Extortion"@en ;
    skos:definition "Obtaining benefit through coercion, threat, or abuse of power."@en .

cpm:Favoritism a owl:Class ;
    rdfs:subClassOf cpm:CorruptAct ;
    rdfs:label "Favoritism"@en ;
    skos:definition "Preferential treatment of a favoured actor without fair, transparent, or merit-based justification."@en .

cpm:Nepotism a owl:Class ;
    rdfs:subClassOf cpm:Favoritism ;
    rdfs:label "Nepotism"@en ;
    skos:definition "Favoritism based on family or close personal relationships."@en .

cpm:ConflictOfInterest a owl:Class ;
    rdfs:subClassOf cpm:CorruptAct ;
    rdfs:label "Conflict of interest"@en ;
    skos:definition "A corrupt or unmanaged conflict between public, project, fiduciary, or professional duty and private interest."@en .

cpm:AbuseOfDiscretion a owl:Class ;
    rdfs:subClassOf cpm:CorruptAct ;
    rdfs:label "Abuse of discretion"@en ;
    skos:definition "Improper exploitation of discretionary authority for undue benefit."@en .

cpm:AbuseOfAuthority a owl:Class ;
    rdfs:subClassOf cpm:CorruptAct ;
    rdfs:label "Abuse of authority"@en ;
    skos:definition "Improper use of official or organisational authority to distort project outcomes."@en .

cpm:ProcurementManipulation a owl:Class ;
    rdfs:subClassOf
        cpm:CorruptAct,
        [ a owl:Restriction ; owl:onProperty cpm:occursInPhase ; owl:someValuesFrom cpm:ProcurementPhase ],
        [ a owl:Restriction ; owl:onProperty cpm:relatedToProcurementMethod ; owl:someValuesFrom cpm:SingleSourceProcurement ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:TailoredSpecifications ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:UnusuallyShortTenderPeriod ] ;
    rdfs:label "Procurement manipulation"@en ;
    skos:definition "Manipulation of procurement planning, solicitation, evaluation, or award to produce improper benefit."@en .

cpm:TenderSpecificationManipulation a owl:Class ;
    rdfs:subClassOf cpm:ProcurementManipulation ;
    rdfs:label "Tender specification manipulation"@en ;
    skos:definition "Manipulation of technical or commercial specifications to favour or exclude specific bidders."@en .

cpm:BidSuppression a owl:Class ;
    rdfs:subClassOf cpm:BidRigging ;
    rdfs:label "Bid suppression"@en ;
    skos:definition "A bid-rigging strategy in which one or more firms agree not to bid or to withdraw bids."@en .

cpm:ComplementaryBidding a owl:Class ;
    rdfs:subClassOf cpm:BidRigging ;
    rdfs:label "Complementary bidding"@en ;
    skos:definition "A bid-rigging strategy in which non-winning bids are intentionally non-competitive."@en .

cpm:CoverBidding a owl:Class ;
    rdfs:subClassOf cpm:BidRigging ;
    rdfs:label "Cover bidding"@en ;
    skos:definition "A bid-rigging strategy in which bids are submitted to create the appearance of competition."@en .

cpm:MarketAllocation a owl:Class ;
    rdfs:subClassOf cpm:Collusion ;
    rdfs:label "Market allocation"@en ;
    skos:definition "Collusive allocation of markets, territories, or client segments among firms."@en .

cpm:PriceFixing a owl:Class ;
    rdfs:subClassOf cpm:Collusion ;
    rdfs:label "Price fixing"@en ;
    skos:definition "Collusive coordination of prices, markups, or related commercial terms."@en .

cpm:InvoiceFraud a owl:Class ;
    rdfs:subClassOf
        cpm:Fraud,
        [ a owl:Restriction ; owl:onProperty cpm:occursInContractStage ; owl:someValuesFrom cpm:PaymentCertificationStage ],
        [ a owl:Restriction ; owl:onProperty cpm:occursInContractStage ; owl:someValuesFrom cpm:ContractExecutionStage ],
        [ a owl:Restriction ; owl:onProperty cpm:occursInContractStage ; owl:someValuesFrom cpm:ClaimsAndDisputesStage ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:AbnormalPaymentPattern ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:FrontLoadedPayments ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:PoorDocumentation ],
        [ a owl:Restriction ; owl:onProperty cpm:hasImpact ; owl:someValuesFrom cpm:CostOverrun ],
        [ a owl:Restriction ; owl:onProperty cpm:hasImpact ; owl:someValuesFrom cpm:LegalLiability ] ;
    rdfs:label "Invoice fraud"@en ;
    skos:definition "Fraud involving false, inflated, duplicated, or manipulated invoicing."@en .

cpm:FalseClaim a owl:Class ;
    rdfs:subClassOf cpm:Fraud ;
    rdfs:label "False claim"@en ;
    skos:definition "A knowingly false claim for payment, entitlement, certification, or project benefit."@en .

cpm:FalseCertification a owl:Class ;
    rdfs:subClassOf
        cpm:Fraud,
        [ a owl:Restriction ; owl:onProperty cpm:occursInPhase ; owl:someValuesFrom cpm:InspectionPhase ],
        [ a owl:Restriction ; owl:onProperty cpm:occursInContractStage ; owl:someValuesFrom cpm:PaymentCertificationStage ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:QualityDefectsDespiteCertification ],
        [ a owl:Restriction ; owl:onProperty cpm:isDetectedBy ; owl:someValuesFrom cpm:IndependentTechnicalAudit ] ;
    rdfs:label "False certification"@en ;
    skos:definition "Issuing or relying on a knowingly false certification of quality, completion, quantity, or compliance."@en .

cpm:DocumentFalsification a owl:Class ;
    rdfs:subClassOf cpm:Fraud ;
    rdfs:label "Document falsification"@en ;
    skos:definition "Falsifying, altering, or fabricating project records or supporting documents."@en .

cpm:QualityInspectionFraud a owl:Class ;
    rdfs:subClassOf
        cpm:Fraud,
        [ a owl:Restriction ; owl:onProperty cpm:occursInPhase ; owl:someValuesFrom cpm:InspectionPhase ],
        [ a owl:Restriction ; owl:onProperty cpm:occursInContractStage ; owl:someValuesFrom cpm:PaymentCertificationStage ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:DelayedInspectionReports ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:QualityDefectsDespiteCertification ],
        [ a owl:Restriction ; owl:onProperty cpm:isDetectedBy ; owl:someValuesFrom cpm:RealTimeProjectMonitoring ],
        [ a owl:Restriction ; owl:onProperty cpm:isDetectedBy ; owl:someValuesFrom cpm:IndependentTechnicalAudit ],
        [ a owl:Restriction ; owl:onProperty cpm:hasImpact ; owl:someValuesFrom cpm:SafetyRisk ],
        [ a owl:Restriction ; owl:onProperty cpm:hasImpact ; owl:someValuesFrom cpm:PoorQuality ],
        [ a owl:Restriction ; owl:onProperty cpm:hasImpact ; owl:someValuesFrom cpm:InfrastructureUnderperformance ] ;
    rdfs:label "Quality inspection fraud"@en ;
    skos:definition "Fraud involving manipulated inspection findings, overlooked defects, or improper quality approval."@en .

cpm:VariationOrderManipulation a owl:Class ;
    rdfs:subClassOf
        cpm:ProcurementManipulation,
        [ a owl:Restriction ; owl:onProperty cpm:occursInPhase ; owl:someValuesFrom cpm:ConstructionOrImplementationPhase ],
        [ a owl:Restriction ; owl:onProperty cpm:occursInContractStage ; owl:someValuesFrom cpm:VariationOrderStage ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:FrequentVariationOrders ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:LargeCostIncreaseAfterAward ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:UnexplainedScopeChanges ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:RepeatedChangeOrders ],
        [ a owl:Restriction ; owl:onProperty cpm:isMitigatedBy ; owl:someValuesFrom cpm:VariationOrderReviewBoard ],
        [ a owl:Restriction ; owl:onProperty cpm:isMitigatedBy ; owl:someValuesFrom cpm:TechnicalAudit ],
        [ a owl:Restriction ; owl:onProperty cpm:isMitigatedBy ; owl:someValuesFrom cpm:ContractPerformanceMonitoring ],
        [ a owl:Restriction ; owl:onProperty cpm:hasImpact ; owl:someValuesFrom cpm:CostOverrun ],
        [ a owl:Restriction ; owl:onProperty cpm:hasImpact ; owl:someValuesFrom cpm:ScheduleDelay ],
        [ a owl:Restriction ; owl:onProperty cpm:hasImpact ; owl:someValuesFrom cpm:PoorQuality ],
        [ a owl:Restriction ; owl:onProperty cpm:exploitsDecisionPoint ; owl:someValuesFrom cpm:VariationApprovalDecisionPoint ] ;
    rdfs:label "Variation order manipulation"@en ;
    skos:altLabel "Change order manipulation"@en ;
    skos:definition "Manipulation of variation orders or change orders to obtain improper financial or schedule benefit."@en .

cpm:ChangeOrderAbuse a owl:Class ;
    rdfs:subClassOf cpm:VariationOrderManipulation ;
    rdfs:label "Change order abuse"@en ;
    skos:definition "Abuse of project changes to create unjustified, inflated, or strategically timed adjustments."@en .

cpm:PaymentManipulation a owl:Class ;
    rdfs:subClassOf
        cpm:Fraud,
        [ a owl:Restriction ; owl:onProperty cpm:occursInContractStage ; owl:someValuesFrom cpm:PaymentCertificationStage ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:AbnormalPaymentPattern ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:FrontLoadedPayments ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:DelayedInspectionReports ],
        [ a owl:Restriction ; owl:onProperty cpm:isDetectedBy ; owl:someValuesFrom cpm:DigitalPaymentTraceability ],
        [ a owl:Restriction ; owl:onProperty cpm:isDetectedBy ; owl:someValuesFrom cpm:FinancialAudit ],
        [ a owl:Restriction ; owl:onProperty cpm:exploitsDecisionPoint ; owl:someValuesFrom cpm:PaymentCertificationDecisionPoint ] ;
    rdfs:label "Payment manipulation"@en ;
    skos:definition "Manipulation of payment timing, amount, approval, routing, or certification for improper benefit."@en .

cpm:GhostWork a owl:Class ;
    rdfs:subClassOf cpm:Fraud ;
    rdfs:label "Ghost work"@en ;
    skos:definition "Claiming payment for work that was not performed or not performed as represented."@en .

cpm:GhostSupplier a owl:Class ;
    rdfs:subClassOf cpm:Fraud ;
    rdfs:label "Ghost supplier"@en ;
    skos:definition "Using a non-genuine, fictitious, or shell supplier in project transactions."@en .

cpm:Overbilling a owl:Class ;
    rdfs:subClassOf
        cpm:Fraud,
        [ a owl:Restriction ; owl:onProperty cpm:occursInPhase ; owl:someValuesFrom cpm:ConstructionOrImplementationPhase ],
        [ a owl:Restriction ; owl:onProperty cpm:occursInContractStage ; owl:someValuesFrom cpm:VariationOrderStage ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:InflatedUnitPrices ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:LargeCostIncreaseAfterAward ],
        [ a owl:Restriction ; owl:onProperty cpm:hasImpact ; owl:someValuesFrom cpm:CostOverrun ] ;
    rdfs:label "Overbilling"@en ;
    skos:definition "Charging above legitimate quantities, rates, or delivered scope."@en .

cpm:UnderperformanceConcealment a owl:Class ;
    rdfs:subClassOf cpm:Fraud ;
    rdfs:label "Underperformance concealment"@en ;
    skos:definition "Concealing quality, delivery, or performance failures to protect improper benefit."@en .

cpm:ConfidentialInformationLeakage a owl:Class ;
    rdfs:subClassOf cpm:CorruptAct ;
    rdfs:label "Confidential information leakage"@en ;
    skos:definition "Improper disclosure of confidential project or procurement information to advantage a party."@en .

cpm:RegulatoryCapture a owl:Class ;
    rdfs:subClassOf cpm:CorruptAct ;
    rdfs:label "Regulatory capture"@en ;
    skos:definition "A situation in which regulatory processes are dominated by the interests they are meant to oversee."@en .

cpm:PoliticalInterference a owl:Class ;
    rdfs:subClassOf cpm:CorruptAct ;
    rdfs:label "Political interference"@en ;
    skos:definition "Improper political intervention in technical, procurement, funding, or oversight decisions."@en .

cpm:FacilitationPayment a owl:Class ;
    rdfs:subClassOf cpm:Bribery ;
    rdfs:label "Facilitation payment"@en ;
    skos:definition "A payment made to expedite or secure routine action to which the payer is not legitimately entitled."@en .

cpm:AssetMisappropriation a owl:Class ;
    rdfs:subClassOf
        cpm:CorruptAct,
        [ a owl:Restriction ; owl:onProperty cpm:targetsAssetOrResource ; owl:someValuesFrom cpm:BudgetAllocation ],
        [ a owl:Restriction ; owl:onProperty cpm:targetsAssetOrResource ; owl:someValuesFrom cpm:ConstructionMaterial ] ;
    rdfs:label "Asset misappropriation"@en ;
    skos:definition "Improper diversion, theft, or misuse of project funds, materials, or other resources."@en .

