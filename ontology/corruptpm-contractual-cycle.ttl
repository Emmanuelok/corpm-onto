@prefix cpm: <https://w3id.org/corruptpm/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

cpm:corruptpm-contractual-cycle a owl:Ontology ;
    rdfs:label "corruptpm contractual cycle module"@en ;
    owl:imports <corruptpm-core.ttl>, <corruptpm-causes-vulnerabilities.ttl>, <corruptpm-controls.ttl>, <corruptpm-indicators.ttl>, <corruptpm-corrupt-acts.ttl>, <corruptpm-impacts.ttl> .

cpm:NeedsAssessmentStage a owl:Class ;
    rdfs:subClassOf cpm:ContractStage ;
    rdfs:label "Needs assessment stage"@en ;
    skos:definition "The contract-cycle stage in which needs are framed, justified, and translated into procurement intent."@en .

cpm:TenderPreparationStage a owl:Class ;
    rdfs:subClassOf
        cpm:ContractStage,
        [ a owl:Restriction ; owl:onProperty cpm:hasCorruptAct ; owl:someValuesFrom cpm:TenderSpecificationManipulation ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:VagueTechnicalSpecifications ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:TailoredSpecifications ] ;
    rdfs:label "Tender preparation stage"@en ;
    skos:definition "The stage in which tender documentation, specifications, evaluation criteria, and solicitation materials are prepared."@en .

cpm:PrequalificationStage a owl:Class ;
    rdfs:subClassOf cpm:ContractStage ;
    rdfs:label "Prequalification stage"@en ;
    skos:definition "The stage in which suppliers or bidders are screened for eligibility or capability before invitation."@en .

cpm:BidSubmissionStage a owl:Class ;
    rdfs:subClassOf cpm:ContractStage ;
    rdfs:label "Bid submission stage"@en ;
    skos:definition "The stage in which bids or proposals are submitted into the procurement process."@en .

cpm:BidEvaluationStage a owl:Class ;
    rdfs:subClassOf
        cpm:ContractStage,
        [ a owl:Restriction ; owl:onProperty cpm:hasRiskFactor ; owl:someValuesFrom cpm:OpaqueProcurement ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRiskFactor ; owl:someValuesFrom cpm:InadequateCompetition ],
        [ a owl:Restriction ; owl:onProperty cpm:hasCorruptAct ; owl:someValuesFrom cpm:BidRigging ],
        [ a owl:Restriction ; owl:onProperty cpm:hasCorruptAct ; owl:someValuesFrom cpm:Collusion ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:IdenticalBidDocuments ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:BidPricesTooClose ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:RepeatedContractAwardsToSameFirm ],
        [ a owl:Restriction ; owl:onProperty cpm:isMitigatedBy ; owl:someValuesFrom cpm:EProcurement ],
        [ a owl:Restriction ; owl:onProperty cpm:isMitigatedBy ; owl:someValuesFrom cpm:IndependentAudit ],
        [ a owl:Restriction ; owl:onProperty cpm:isMitigatedBy ; owl:someValuesFrom cpm:RedFlagAnalytics ],
        [ a owl:Restriction ; owl:onProperty cpm:hasImpact ; owl:someValuesFrom cpm:ReducedCompetition ] ;
    rdfs:label "Bid evaluation stage"@en ;
    skos:definition "The stage in which bids are reviewed, scored, interpreted, compared, and recommended for decision."@en .

cpm:ContractAwardStage a owl:Class ;
    rdfs:subClassOf
        cpm:ContractStage,
        [ a owl:Restriction ; owl:onProperty cpm:hasRiskFactor ; owl:someValuesFrom cpm:PoliticalPatronage ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRiskFactor ; owl:someValuesFrom cpm:OpaqueProcurement ] ;
    rdfs:label "Contract award stage"@en ;
    skos:definition "The stage in which a supplier or contractor is selected and award is formalised."@en .

cpm:ContractNegotiationStage a owl:Class ;
    rdfs:subClassOf cpm:ContractStage ;
    rdfs:label "Contract negotiation stage"@en ;
    skos:definition "The stage in which terms, scope, and obligations are negotiated before signature or notice to proceed."@en .

cpm:ContractExecutionStage a owl:Class ;
    rdfs:subClassOf
        cpm:ContractStage,
        [ a owl:Restriction ; owl:onProperty cpm:hasCorruptAct ; owl:someValuesFrom cpm:InvoiceFraud ],
        [ a owl:Restriction ; owl:onProperty cpm:hasCorruptAct ; owl:someValuesFrom cpm:Overbilling ] ;
    rdfs:label "Contract execution stage"@en ;
    skos:definition "The stage in which works, services, or supply obligations are executed."@en .

cpm:PaymentCertificationStage a owl:Class ;
    rdfs:subClassOf
        cpm:ContractStage,
        [ a owl:Restriction ; owl:onProperty cpm:hasRiskFactor ; owl:someValuesFrom cpm:PoorRecordKeeping ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRiskFactor ; owl:someValuesFrom cpm:WeakAuditCapacity ],
        [ a owl:Restriction ; owl:onProperty cpm:hasCorruptAct ; owl:someValuesFrom cpm:PaymentManipulation ],
        [ a owl:Restriction ; owl:onProperty cpm:hasCorruptAct ; owl:someValuesFrom cpm:InvoiceFraud ],
        [ a owl:Restriction ; owl:onProperty cpm:hasCorruptAct ; owl:someValuesFrom cpm:FalseCertification ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:AbnormalPaymentPattern ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:FrontLoadedPayments ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:DelayedInspectionReports ],
        [ a owl:Restriction ; owl:onProperty cpm:isMitigatedBy ; owl:someValuesFrom cpm:DigitalPaymentTraceability ],
        [ a owl:Restriction ; owl:onProperty cpm:isMitigatedBy ; owl:someValuesFrom cpm:FinancialAudit ],
        [ a owl:Restriction ; owl:onProperty cpm:isDetectedBy ; owl:someValuesFrom cpm:RealTimeProjectMonitoring ] ;
    rdfs:label "Payment certification stage"@en ;
    skos:definition "The stage in which quantities, invoices, progress, or compliance are certified to trigger payment."@en .

cpm:VariationOrderStage a owl:Class ;
    rdfs:subClassOf
        cpm:ContractStage,
        [ a owl:Restriction ; owl:onProperty cpm:hasRiskFactor ; owl:someValuesFrom cpm:PoorContractManagement ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRiskFactor ; owl:someValuesFrom cpm:DiscretionaryDecisionMaking ],
        [ a owl:Restriction ; owl:onProperty cpm:hasCorruptAct ; owl:someValuesFrom cpm:VariationOrderManipulation ],
        [ a owl:Restriction ; owl:onProperty cpm:hasCorruptAct ; owl:someValuesFrom cpm:ChangeOrderAbuse ],
        [ a owl:Restriction ; owl:onProperty cpm:hasCorruptAct ; owl:someValuesFrom cpm:Overbilling ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:FrequentVariationOrders ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:LargeCostIncreaseAfterAward ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:UnexplainedScopeChanges ],
        [ a owl:Restriction ; owl:onProperty cpm:hasRedFlag ; owl:someValuesFrom cpm:RepeatedChangeOrders ],
        [ a owl:Restriction ; owl:onProperty cpm:hasImpact ; owl:someValuesFrom cpm:CostOverrun ],
        [ a owl:Restriction ; owl:onProperty cpm:hasImpact ; owl:someValuesFrom cpm:ScheduleDelay ],
        [ a owl:Restriction ; owl:onProperty cpm:isMitigatedBy ; owl:someValuesFrom cpm:VariationOrderReviewBoard ],
        [ a owl:Restriction ; owl:onProperty cpm:isMitigatedBy ; owl:someValuesFrom cpm:TechnicalAudit ],
        [ a owl:Restriction ; owl:onProperty cpm:isMitigatedBy ; owl:someValuesFrom cpm:ContractPerformanceMonitoring ] ;
    rdfs:label "Variation order stage"@en ;
    skos:definition "The stage in which variations, change orders, and related price or schedule adjustments are reviewed and approved."@en .

cpm:ClaimsAndDisputesStage a owl:Class ;
    rdfs:subClassOf
        cpm:ContractStage,
        [ a owl:Restriction ; owl:onProperty cpm:hasCorruptAct ; owl:someValuesFrom cpm:InvoiceFraud ] ;
    rdfs:label "Claims and disputes stage"@en ;
    skos:definition "The stage in which claims, disputes, and associated settlement or adjudication processes are managed."@en .

cpm:ContractMonitoringStage a owl:Class ;
    rdfs:subClassOf cpm:ContractStage ;
    rdfs:label "Contract monitoring stage"@en ;
    skos:definition "The stage in which delivery performance, compliance, and documentation are monitored."@en .

cpm:ContractClosureStage a owl:Class ;
    rdfs:subClassOf cpm:ContractStage ;
    rdfs:label "Contract closure stage"@en ;
    skos:definition "The stage in which contract obligations are closed out and final records are completed."@en .

