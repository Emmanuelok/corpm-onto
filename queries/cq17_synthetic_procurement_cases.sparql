PREFIX cpm: <https://w3id.org/corruptpm/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?case ?caseName ?event ?eventLabel
WHERE {
  ?case a cpm:SyntheticCaseStudy ;
        cpm:caseName ?caseName .
  ?event a cpm:CorruptionEvent ;
         cpm:documentedInCaseStudy ?case ;
         cpm:occursInPhase ?phase .
  ?phase rdf:type cpm:ProcurementPhase .
  OPTIONAL { ?event rdfs:label ?eventLabel }
}
ORDER BY ?caseName

